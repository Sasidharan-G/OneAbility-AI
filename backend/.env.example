# Copy to backend/.env and fill in. The key stays on the server (SEC-10).
# Get a key at https://aistudio.google.com/apikey . Without it the app uses the
# built-in deterministic Tamil/English/Tanglish parser and everything still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=8

# Safety thresholds (rupees)
HIGH_AMOUNT_THRESHOLD=5000
TXN_LIMIT=100000
DUPLICATE_WINDOW_SECONDS=120
FLOW_TTL_SECONDS=600

# Set to 0 if Node server.js serves the frontend instead of FastAPI
SERVE_FRONTEND=1
